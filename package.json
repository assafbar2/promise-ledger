{
  "name": "promise-ledger",
  "version": "0.1.1",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "build:vercel": "NITRO_PRESET=vercel vite build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "node --import tsx --test tests/*.test.ts",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern .output --ignore-pattern .vercel --ignore-pattern .nitro",
    "test:render": "npm run build && node --test tests/rendered-html.test.mjs",
    "test:vercel": "npm run build:vercel && node --test tests/vercel-rendered.test.mjs",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint && npm test && npm run test:render",
    "eval": "node --import tsx scripts/evaluate.ts",
    "eval:live": "node --env-file-if-exists=.env.local --import tsx scripts/evaluate-live.ts",
    "eval:development": "npm run eval:live -- --suite=development",
    "eval:held-out": "npm run eval:live -- --suite=held-out",
    "eval:pipeline": "node --env-file-if-exists=.env.local --import tsx scripts/evaluate-pipeline.ts",
    "seed:sentry": "node --env-file-if-exists=.env.local --import tsx scripts/seed-sentry.ts",
    "sentry:check": "node --env-file-if-exists=.env.local --import tsx scripts/sentry-runtime-check.ts",
    "smoke:live": "node --env-file-if-exists=.env.local --import tsx scripts/pipeline-smoke.ts"
  },
  "dependencies": {
    "lucide-react": "^1.45.0",
    "next": "^16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.8",
    "@cloudflare/workers-types": "^5.20260911.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "^16.3.5",
    "nitro": "3.0.260903-beta",
    "react-server-dom-webpack": "^19.3.0",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.13",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "^8.3.0",
    "wrangler": "^4.131.1"
  },
  "type": "module",
  "overrides": {
    "vinext": {
      "image-size": "2.0.4"
    }
  }
}
